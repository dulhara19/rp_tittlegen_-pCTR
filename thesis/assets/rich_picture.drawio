    </mxCell>

    <!-- Sub-box: BERTScore -->
    <mxCell id="93" value="&lt;b&gt;BERTScore  Semantic Relevance  (F1)&lt;/b&gt;&#xa;→  Title vs. video summary  |  &lt; 0.30 = off-topic  |  0.30–0.60 = target range  |  &gt; 0.60 = over-descriptive"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8daef;strokeColor=#6c3483;strokeWidth=1.5;fontSize=9.5;align=left;spacingLeft=10;verticalAlign=middle;"
